{
  "name": "ycdesk-signaling-server",
  "version": "0.1.1",
  "description": "Signaling server for YCDesk remote desktop",
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "assets": [
      "../server-gui/server/server-module.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --output dist/server.exe",
    "test": "echo \"No tests configured for server. Run 'npm test' from windows/ to run shared tests.\" && exit 0"
  },
  "keywords": [
    "remote-desktop",
    "webrtc",
    "signaling-server"
  ],
  "author": "YCDesk Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-forge": "^1.4.0",
    "socket.io": "^4.7.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nexe": "^5.0.0-beta.4",
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  }
}
