# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source files
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.properties text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.nsh text eol=lf

# Binary files
*.png binary
*.ico binary
*.jpg binary
*.jar binary
*.dll binary
*.exe binary

# LFS
linux/ycdesk-linux-1.0.0/ycdesk-linux filter=lfs diff=lfs merge=lfs -text
