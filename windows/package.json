{
  "name": "ycdesk",
  "version": "2.1.0",
  "description": "远程桌面控制软件 - Windows 版本",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron . --dev",
    "dev:watch": "nodemon --exec 'npm run dev' --watch src --watch shared --ext js,html",
    "sync": "node sync-shared.js",
    "prebuild": "node sync-shared.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:watch": "node watch-build.js"
  },
  "keywords": [
    "remote",
    "desktop",
    "control",
    "webrtc",
    "electron",
    "windows"
  ],
  "devDependencies": {
    "chokidar": "^3.6.0",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "nodemon": "^3.0.0"
  },
  "dependencies": {
    "robotjs": "0.6.0",
    "socket.io-client": "^4.6.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "build": {
    "appId": "com.ycdesk.desktop",
    "productName": "YCDesk",
    "asar": false,
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "dist-v2"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!**/*.log",
      "!dist*/**",
      "!android/**",
      "!server/**",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/.bin"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "YCDesk-Portable-${version}.exe"
    }
  }
}
