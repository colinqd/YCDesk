{
  "name": "ycdesk",
  "version": "0.0.1",
  "description": "远程桌面控制软件 - Windows 版本",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron . --dev",
    "dev:watch": "nodemon --exec \"npm run dev\" --watch src --watch shared --ext js,html",
    "sync": "node sync-shared.js",
    "prebuild": "node sync-shared.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:debug": "cross-env NODE_ENV=development electron-builder --config electron-builder-debug.yml --win",
    "build:watch": "node watch-build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "remote",
    "desktop",
    "control",
    "webrtc",
    "electron",
    "windows"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.1",
    "chokidar": "^3.6.0",
    "cross-env": "^7.0.3",
    "electron": "28.3.3",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.3",
    "nodemon": "^3.0.0",
    "rcedit": "^5.0.2",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "socket.io-client": "^4.6.0"
  },
  "build": {
    "appId": "com.ycdesk.desktop",
    "productName": "YCDesk",
    "asar": false,
    "compression": "maximum",
    "directories": {
      "output": "dist-v2"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!**/*.log",
      "!dist*/**",
      "!credential_provider/**",
      "!resources/**",
      "!assets/**",
      "!data/**",
      "!*.bat",
      "!nodemon.json",
      "!watch-build.js",
      "!sync-shared.js",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/.bin",
      "!service/build/**"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "service/",
        "filter": [
          "YCDeskService.exe"
        ]
      },
      {
        "from": "bin/YCDeskCredentialProvider.dll",
        "to": "cred-provider/YCDeskCredentialProvider.dll"
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "YCDesk-Setup-${version}.exe",
      "include": "installer/install-cred-provider.nsh"
    },
    "portable": {
      "artifactName": "YCDesk-Portable-${version}.exe"
    }
  }
}
