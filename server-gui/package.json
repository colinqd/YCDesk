{
  "name": "ycdesk-server-gui",
  "version": "0.2.1",
  "description": "YCDesk 信令服务器 - GUI 版本",
  "main": "src/main.js",
  "scripts": {
    "dev": "node sync-shared.js && electron .",
    "build": "node sync-server-module.js && electron-builder",
    "build:win": "node sync-server-module.js && electron-builder --win --publish never",
    "build:linux": "node sync-server-module.js && electron-builder --linux",
    "test": "echo \"No tests configured for server-gui. Run 'npm test' from windows/ to run shared tests.\" && exit 0"
  },
  "keywords": [
    "ycdesk",
    "signaling",
    "server",
    "electron"
  ],
  "author": "YCDesk Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "cors": "^2.8.5",
    "ws": "^8.14.2"
  },
  "build": {
    "appId": "com.ycdesk.server",
    "productName": "YCDesk Server",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
